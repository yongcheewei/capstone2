# Virtual envs
.venv/
venv/
env/
ENV/

# Data
data/raw/
# The canned sample log is tracked so the dashboard works
# immediately after download. Delete the line below if you want
# ``data/processed/`` to remain empty by default.
!data/processed/sample_auth.log
!data/processed/groundtruth_ips.txt

# Model artefacts (the timestamped bundles are git-ignored; the
# canned ``latest.*`` files are tracked so that a fresh release zip
# is immediately usable without re-training).
src/models/artifacts/*.pkl
src/models/artifacts/random_forest_*.joblib
src/models/artifacts/random_forest_*.meta.json
src/models/artifacts/xgboost_*.joblib
src/models/artifacts/xgboost_*.meta.json
src/models/artifacts/isolation_forest_*.joblib
src/models/artifacts/isolation_forest_*.meta.json
# Explicit allowlist for the canned artefacts shipped with the release
!src/models/artifacts/latest.joblib
!src/models/artifacts/latest.meta.json

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Streamlit
.streamlit/secrets.toml

# Generated pipeline artefacts (re-generated by scripts/run_pipeline.py)
report/figures/*.csv
report/figures/*.json
report/figures/*.png
